DATABASE_URL="your_db_url"
NEXT_PUBLIC_API_URL="http://localhost:8000"
NODE_ENV="development"
BASE_URL="http://localhost:8000"

# Optional: only if sharing cookies across subdomains (e.g. ".formly.com")
COOKIE_DOMAIN=""

# Application URL for generated reset links & redirects
APP_URL="http://localhost:3000"

# SMTP Email Configuration (Nodemailer)
# If left empty in development, reset links will automatically print to your terminal console!
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Formly <no-reply@formly.com>"

# Better Auth Configuration
# Generate with: openssl rand -base64 32 (min 32 characters)
BETTER_AUTH_SECRET="your_better_auth_secret_min_32_characters_here"
BETTER_AUTH_URL="http://localhost:8000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Browser Origin Allowed to Call the API
FRONTEND_URL="http://localhost:3000"