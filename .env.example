DATABASE_URL="your_db_url"
NEXT_PUBLIC_API_URL="http://localhost:8000"
NODE_ENV="development"
BASE_URL="http://localhost:8000"

# Authentication Secrets & Settings
# Generate with: openssl rand -base64 48 (min 32 characters)
JWT_ACCESS_SECRET="your_jwt_access_secret_min_32_characters_here"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Optional: only if sharing cookies across subdomains (e.g. ".formly.com")
COOKIE_DOMAIN=""

# Application URL for generated reset links
APP_URL="http://localhost:3000"

# SMTP Email Configuration (Nodemailer)
# If left empty in development, reset links will automatically print to your terminal console!
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Formly <no-reply@formly.com>"
